# SQLite: события бота, учёт платных запросов, подписка (по умолчанию vk_prompt_bot/data/prompt_bot.sqlite).
# VK_BOT_DB_PATH=

# 1/true — снова показывать DEBUG vkbottle в консоли.
# VK_BOT_DEBUG=

# Токен сообщества VK (должны быть включены «Сообщения сообщества» и Long Poll API).
VK_GROUP_TOKEN=

# То же имя, альтернатива (как в старых инструкциях):
# vk_group_token=

# Ключ и endpoint OpenAI-совместимого API (часто — корень репозитория или vk_console_bot/.env)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o-mini
